# Database Configuration
# PostgreSQL Connection URL format: postgresql://username:password@localhost:5432/delhi_aqi_db
# For local testing without PostgreSQL server running, SQLite fallback is supported: sqlite:///./delhi_aqi.db
DB_URL=postgresql://postgres:postgres@localhost:5432/delhi_aqi_db

# NASA FIRMS API Key (Get free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# If left blank, the ingestion pipeline will use high-fidelity regional simulated stubble burning data
NASA_FIRMS_KEY=your_nasa_firms_map_key_here

# OpenAQ API Key (Optional v3 API key, public tier works without key)
OPENAQ_API_KEY=

# Ingestion Scheduler Intervals (in minutes)
AQI_INGESTION_INTERVAL_MINUTES=60
WEATHER_INGESTION_INTERVAL_MINUTES=60
FIRMS_INGESTION_INTERVAL_MINUTES=180

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
