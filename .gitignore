# Anchored to the repo root: these are Python venv/build dirs. Unanchored,
# 'lib/' matches ANY directory named lib at any depth, which silently
# excluded sih-dashboard/src/lib, airsense-ncr/lib and scratch_ui/src/lib
# from every commit — a fresh clone could not build.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

