# Fetched datasets — regenerate with ml_pipeline/scripts/10-12 rather than
# committing them (raw/ is ~27 MB of Parquet across ~720 files).
ml_pipeline/data/raw/observations/
ml_pipeline/data/raw/forecast/
ml_pipeline/data/raw/stations/
# Derived AQI series — regenerate with ml_pipeline/scripts/13_compute_station_aqi.py
ml_pipeline/data/processed/station_aqi_*.parquet
ml_pipeline/data/processed/gridded_dataset.npy
ml_pipeline/data/processed/gridded_dataset_manifest.json
ml_pipeline/data/processed/spatial_validation.json
ml_pipeline/data/processed/spatial_validation_by_station.csv
# Baseline scores - regenerate with 14_baselines.py
ml_pipeline/data/processed/baselines_*.csv
ml_pipeline/data/processed/baseline_corrections.json

# Screen recordings / large media
*.mp4

# Third-party skills installed by `npx skills add` — per-machine, not project code
.claude/skills/

# Training output: checkpoints are 13 MB each and regenerable from script 16.
backend/weights/

# --- Runtime archive the deployed API reads -------------------------------
# The blend baseline runs in archive_replay mode, so these ~5.5 MB are not a
# cache the host can refetch - they are the forecast. Committing them is what
# makes the deploy self-contained; without them the API boots and serves
# nothing, and a demo that depends on a third-party API being up on the day is
# a demo that fails on the day.
#
# git cannot un-ignore a file inside an ignored directory, so each directory is
# re-admitted, its contents excluded again, and only the needed files named.

# Generated tensors stay out regardless - the 2026 build alone is 1.7 GB.
ml_pipeline/data/processed/gridded_dataset*
ml_pipeline/data/processed/*.log

!ml_pipeline/data/raw/stations/
ml_pipeline/data/raw/stations/*
!ml_pipeline/data/raw/stations/catalog.json

!ml_pipeline/data/raw/forecast/
ml_pipeline/data/raw/forecast/*
!ml_pipeline/data/raw/forecast/forecast_2025.parquet
!ml_pipeline/data/raw/forecast/forecast_2026.parquet

!ml_pipeline/data/raw/observations/
ml_pipeline/data/raw/observations/*
!ml_pipeline/data/raw/observations/season=2025/
ml_pipeline/data/raw/observations/season=2025/*
!ml_pipeline/data/raw/observations/season=2025/pm25_*.parquet
# The other AQI pollutants ship too: the National AQI is the worst of six
# sub-indices, so PM2.5 alone cannot produce one. ~12 MB.
!ml_pipeline/data/raw/observations/season=2025/pm10_*.parquet
!ml_pipeline/data/raw/observations/season=2025/no2_*.parquet
!ml_pipeline/data/raw/observations/season=2025/o3_*.parquet
!ml_pipeline/data/raw/observations/season=2025/so2_*.parquet
# Season 2026 is what the service replays: it runs to 2026-09-07 rather than
# stopping in December. ~46 MB. No SO2 was fetched for this season, which costs
# one sub-index and still leaves four - CPCB requires three.
!ml_pipeline/data/raw/observations/season=2026/
ml_pipeline/data/raw/observations/season=2026/*
!ml_pipeline/data/raw/observations/season=2026/pm25_*.parquet
!ml_pipeline/data/raw/observations/season=2026/pm10_*.parquet
!ml_pipeline/data/raw/observations/season=2026/no2_*.parquet
!ml_pipeline/data/raw/observations/season=2026/o3_*.parquet

# The fitted CAMS bias factor is a four-kilobyte model parameter, not a cache.
!ml_pipeline/data/processed/baseline_corrections.json

# Failed training runs, kept on disk for the record but not worth 14 MB each.
backend/weights_*/

# Partner GFS extract: small, and the API degrades to 204 without it.
!ml_pipeline/data/raw/gfs/
ml_pipeline/data/raw/gfs/*
!ml_pipeline/data/raw/gfs/gfs_ncr.parquet
!ml_pipeline/data/raw/gfs/gfs_ncr_forecast.parquet
